<section aria-label="Introduction" data-ground="dark" class="hero">
  <div class="shader-fallback" aria-hidden="true"></div>
  <webgl-shader force-motion x-scale="0.74" y-scale="0.39" distortion="0.08" intensity="0.018" speed="0.43"></webgl-shader>
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="hero-content">
    <h1 class="hero-headline">
      <span class="hero-line"><span class="hero-line-inner" data-hero-enter>[[PLACEHOLDER: hero — statement line 1]]</span></span>
      <span class="hero-line"><span class="hero-line-inner" data-hero-enter>[[PLACEHOLDER: hero — statement line 2]]</span></span>
    </h1>
    <div class="hero-sub-wrap">
      <p class="hero-sub" data-hero-enter>[[PLACEHOLDER: hero — subline]]</p>
    </div>
  </div>
  <div class="hero-meta" data-hero-meta>
    <span class="hero-meta-avail"><span class="hero-dot" aria-hidden="true"></span>[[PLACEHOLDER: availability]]</span>
    <span>[[PLACEHOLDER: location]]</span>
    <span>[[PLACEHOLDER: est. year]]</span>
    <span class="hero-meta-scroll"><span class="hero-scroll-rule" aria-hidden="true"></span>Scroll</span>
  </div>
</section>
