<section aria-label="Manifesto" data-pin data-ground="dark" class="manifesto">
  <div data-pin-inner class="manifesto-inner">
    <div class="shader-fallback" aria-hidden="true"></div>
    <webgl-shader force-motion x-scale="1.45" y-scale="0.4" distortion="0.05" intensity="0.013" speed="0.55"></webgl-shader>
    <div class="manifesto-scrim" aria-hidden="true"></div>

    <div class="manifesto-eyebrow-wrap">
      <span class="eyebrow">
        <span class="eyebrow-bullet" aria-hidden="true"></span>What we do
      </span>
    </div>

    <div class="manifesto-rule">
      <span data-progress-rule class="manifesto-rule-fill" aria-hidden="true"></span>
    </div>

    <div class="manifesto-grid">
      <div data-step-counter class="step-counter">
        <span data-step-current>01</span><span class="step-counter-rest">/</span><span class="step-counter-rest">03</span>
      </div>
      <div data-steps class="steps">
        <p data-step data-reveal class="step-statement"><span>[[PLACEHOLDER: manifesto statement 01]]</span></p>
        <p data-step data-reveal class="step-statement"><span>[[PLACEHOLDER: manifesto statement 02]]</span></p>
        <p data-step data-reveal class="step-statement"><span>[[PLACEHOLDER: manifesto statement 03]]</span></p>
      </div>
    </div>
  </div>
</section>
